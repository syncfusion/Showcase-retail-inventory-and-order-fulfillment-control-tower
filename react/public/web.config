<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Redirect the bare root to the canonical prefixed mount path so
             visitors who open the default App Service domain
             (https://<app>.azurewebsites.net/) land on the vanity URL the
             build is authored for, instead of Azure's hostingstart.html
             placeholder. Runs first (highest priority) so it intercepts "/"
             before IIS default-document resolution. Mirrors server.mjs. -->
        <rule name="Control tower root redirect" stopProcessing="true">
          <match url="^$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{QUERY_STRING}" pattern="^$" />
          </conditions>
          <action type="Redirect" url="/retail-inventory-control/react/" redirectType="Found" appendQueryString="false" />
        </rule>

        <!-- Also redirect a bare trailing slash at the root (defensive: some
             browsers/probes normalize / to nothing; handle both forms). -->
        <rule name="Control tower root slash redirect" stopProcessing="true">
          <match url="^/$" />
          <action type="Redirect" url="/retail-inventory-control/react/" redirectType="Found" appendQueryString="false" />
        </rule>

        <!-- Serve prefixed static assets from the App Service root when a proxy forwards /retail-inventory-control/react/* unchanged. -->
        <rule name="Control tower prefixed static files" stopProcessing="true">
          <match url="^retail-inventory-control/react/(.+)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{APPL_PHYSICAL_PATH}{R:1}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}" />
        </rule>

        <!-- Support /retail-inventory-control/react, /retail-inventory-control/react/, and nested SPA routes. -->
        <rule name="Control tower prefixed SPA routes" stopProcessing="true">
          <match url="^retail-inventory-control/react(?:/.*)?$" />
          <action type="Rewrite" url="/index.html" />
        </rule>

        <!-- Keep direct App Service root URLs and deep links working. -->
        <rule name="Root SPA routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
